# 이 파일을 복사해 .env 로 만들고 값을 채운다. .env 는 GitHub 에 올라가지 않는다.

# 주소를 좌표로 바꾸는 데 쓴다. PC 에만 두고 앱(APK)에는 들어가지 않는다.
# developers.kakao.com > 앱 설정 > 플랫폼 키 > REST API 키
KAKAO_REST_API_KEY=

# 앱 안의 지도를 카카오맵으로 띄운다. 비워두면 OpenStreetMap 을 쓴다.
# 이 키는 APK 에 들어가지만 등록한 도메인에서만 동작한다.
# developers.kakao.com > 앱 설정 > 플랫폼 키 > JavaScript 키
KAKAO_JS_KEY=
KAKAO_MAP_ORIGIN=https://estate-watch.local
