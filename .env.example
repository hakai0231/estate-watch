# 이 파일을 복사해 .env 로 만들고 값을 채운다. .env 는 GitHub 에 올라가지 않는다.

# [필수] 주소를 좌표로 바꾼다. PC 에만 두고 앱(APK)에는 들어가지 않는다.
# developers.kakao.com > 앱 설정 > 플랫폼 키 > REST API 키
KAKAO_REST_API_KEY=

# [선택] 앱 안 지도. 아래 순서로 하나만 있으면 된다. 셋 다 없으면 OSM 을 쓴다.
#   1순위 네이버 지도  — ncloud.com > Application > Maps 의 Client ID
NAVER_MAP_CLIENT_ID=
NAVER_MAP_ORIGIN=https://estate-watch.local
#   2순위 카카오맵     — developers.kakao.com > 앱 설정 > 플랫폼 키 > JavaScript 키
KAKAO_JS_KEY=
KAKAO_MAP_ORIGIN=https://estate-watch.local
